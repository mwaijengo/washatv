# Copy to `.env` for local dev:  cp .env.example .env
# `npm run dev` loads `.env` automatically (via dotenv). Railway uses its dashboard variables instead.
#
# --- Align with Flutter apps (compile-time --dart-define) ---
# Production uses the API deployed on Railway directly (default URL below).
# Override WASHA_API_BASE_URL only for local backend dev (e.g. http://127.0.0.1:8080).
# User app [lib/services/public_api_service.dart]:
#   WASHA_API_BASE_URL   = same origin you use below for the public API (no trailing slash)
#     default in code: https://washatv-production.up.railway.app
# Admin app [lib/admin/admin_dashboard_app.dart]:
#   WASHA_API_BASE_URL   = must match this API base URL
#   WASHA_ADMIN_API_KEY  = Flutter compile-time name only; must be the SAME secret string as
#                           ADMIN_API_KEY on Railway / below (two names, one password).
# -----------------------------------------------------------------------------

# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/washa

# Required by schema (min 16 chars). Change in production.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# CORS: * = reflect any Origin (good for Flutter web on random localhost ports).
# Production: comma-separated exact origins, e.g. https://app.example.com,https://admin.example.com
# Localhost on any port is also allowed by code when this is not *.
CORS_ORIGIN=*

# Optional: admin login (JWT). If both missing, login route returns 503 unless ADMIN_API_KEY is set.
ADMIN_EMAIL=admin@washa.local
# bcrypt hash — generate: node scripts/hash-password.mjs "your-secret"
ADMIN_PASSWORD_HASH=$2b$10$replace_with_bcrypt_hash

# Optional: same secret as Flutter --dart-define=WASHA_ADMIN_API_KEY (Railway calls this ADMIN_API_KEY).
ADMIN_API_KEY=

# --- Viewer app security (secure playback) ---
# Required in production (>= 32 random chars). Must equal `appSigningSecret` in android/key.properties.
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
APP_SIGNING_SECRET=
# APP_PACKAGE_NAME=com.washatv
# SHA-256 of the Play Console "App signing key certificate" (Setup → App signing). Comma-separate several.
# Leave empty first: the API logs the digest each session ("unknown signing certificate") so you can copy it.
# ALLOWED_APP_CERT_SHA256=
# Then set to true to refuse re-packaged / modded APKs.
# APP_CERT_ENFORCE=false
# Client integrity flags that block playback: dbg (debugger), hook (Frida/Xposed), root, emu
# BLOCKED_CLIENT_FLAGS=dbg,hook
# Transitional: true keeps raw stream URLs in /public/bootstrap for builds older than secure playback.
# Turn off as soon as force-update is on for the new build — while true, channels can be copied.
# LEGACY_CATALOG_STREAMS=false
# PLAYBACK_RESOLVES_PER_HOUR=150
# VIEWER_SESSION_TTL_SECONDS=7200

# --- IP locking (client IP comes from Railway's X-Real-IP, which callers cannot forge) ---
# Viewer tokens only work from the network they were issued on; the app re-signs automatically after a network change.
# VIEWER_IP_BINDING=true
# Admin tokens only work from the IP used to log in (switching Wi-Fi/mobile data → log in again).
# ADMIN_IP_BINDING=true
# ADMIN_SESSION_TTL_SECONDS=28800
# Optional: only these IPs / CIDRs may use the admin API at all (login, JWT and X-Admin-Key), e.g.
# ADMIN_ALLOWED_IPS=41.59.1.10,102.69.0.0/16
# ADMIN_ALLOWED_IPS=

# Optional Postgres pool cap (defaults in code if unset)
# PG_POOL_MAX=20

# SonicPesa (Fungua zote / M-Pesa) — server-side only; never put in Flutter --dart-define
# SONICPESA_API_KEY=
# SONICPESA_SECRET_KEY=
# SONICPESA_BASE_URL=https://api.sonicpesa.com
# Optional webhook auth (set same secret in SonicPesa if they support custom headers)
# SONICPESA_WEBHOOK_SECRET=

# Optional: Washa admin "Send notification" also triggers Supasoka FCM (same push as supaadmin)
# SUPASOKA_API_BASE_URL=https://supasokatv-production.up.railway.app
# SUPASOKA_ADMIN_API_KEY=same-as-supasoka-ADMIN_API_KEY
#
# Paste in SonicPesa → Webhook System → HTTPS ENDPOINT URL (after deploy):
# https://washatv-production.up.railway.app/api/v1/webhooks/sonicpesa
