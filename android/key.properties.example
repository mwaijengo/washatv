# Copy to android/key.properties (never commit key.properties).
# Generate keystore: ./scripts/generate_upload_keystore.sh
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
# Same value as APP_SIGNING_SECRET on the API server (>= 32 random chars). Required for release builds.
appSigningSecret=REPLACE_WITH_LONG_RANDOM_SECRET
